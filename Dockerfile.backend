# Backend (Node/Express) + Python ML scripts. Build context = repo root.

# Stage 1: Node deps (bcrypt is a native module, so install inside a Linux image)
FROM node:22-slim AS node-deps
WORKDIR /app/Backend
COPY Backend/package*.json ./
RUN npm ci --omit=dev --no-audit --no-fund

# Stage 2: Python 3.12 image with the Node binary copied in
FROM python:3.12-slim
COPY --from=node-deps /usr/local/bin/node /usr/local/bin/node

WORKDIR /app

# CPU-only torch keeps the image small
COPY ML/requirements.txt ML/requirements.txt
RUN pip install --no-cache-dir --extra-index-url https://download.pytorch.org/whl/cpu -r ML/requirements.txt
ENV PYTHON=python3

COPY --from=node-deps /app/Backend/node_modules Backend/node_modules
COPY Backend/package*.json Backend/
COPY Backend/src Backend/src
COPY ML ML

ENV NODE_ENV=production PORT=8080
EXPOSE 8080
WORKDIR /app/Backend
CMD ["node", "--experimental-json-modules", "src/index.js"]
